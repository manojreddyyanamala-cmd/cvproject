<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="visionqueue.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="0"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2881"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="sessions" custom_title="0" dock_id="2" table="4,8:mainsessions"/><dock_state state="000000ff00000000fd00000001000000020000039b00000226fc0100000002fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000000000000000fb000000160064006f0063006b00420072006f007700730065003201000000000000039b0000011800ffffff000002580000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="sessions" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="66"/><column index="2" value="67"/><column index="3" value="61"/><column index="4" value="93"/><column index="5" value="43"/><column index="6" value="61"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="sessions*">CREATE TABLE IF NOT EXISTS sessions (
    session_id TEXT PRIMARY KEY,
    start_time TIMESTAMP NOT NULL,
    end_time TIMESTAMP,
    camera_source TEXT NOT NULL,
    status TEXT NOT NULL CHECK(status IN ('ACTIVE', 'COMPLETED', 'ABORTED', 'ERROR')),
    metadata TEXT
);</sql><sql name="measurments*">CREATE TABLE IF NOT EXISTS measurements (
    measurement_id INTEGER PRIMARY KEY AUTOINCREMENT,
    session_id TEXT NOT NULL,
    timestamp TIMESTAMP NOT NULL,
    current_count INTEGER NOT NULL,
    entry_count INTEGER DEFAULT 0,
    exit_count INTEGER DEFAULT 0,
    occupancy_rate REAL DEFAULT 0.0,
    crowd_state TEXT NOT NULL CHECK(crowd_state IN ('NORMAL', 'MODERATE', 'CONGESTED', 'OVER_CAPACITY')),
    FOREIGN KEY (session_id) REFERENCES sessions(session_id) ON DELETE CASCADE
);</sql><sql name="configuration*">CREATE TABLE IF NOT EXISTS configuration (
    config_key TEXT PRIMARY KEY,
    config_value TEXT NOT NULL,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);</sql><sql name="events*">CREATE TABLE IF NOT EXISTS events (
    event_id INTEGER PRIMARY KEY AUTOINCREMENT,
    session_id TEXT NOT NULL,
    timestamp TIMESTAMP NOT NULL,
    event_type TEXT NOT NULL CHECK(event_type IN ('ALERT', 'OVER_CAPACITY', 'STATE_CHANGE', 'CAMERA_DEGRADED', 'RECONNECTED')),
    severity TEXT NOT NULL CHECK(severity IN ('INFO', 'WARNING', 'CRITICAL')),
    description TEXT NOT NULL,
    payload TEXT,
    FOREIGN KEY (session_id) REFERENCES sessions(session_id) ON DELETE CASCADE
);</sql><sql name="final*">CREATE INDEX IF NOT EXISTS idx_measurements_session_time ON measurements(session_id, timestamp);
CREATE INDEX IF NOT EXISTS idx_events_session_time ON events(session_id, timestamp);
CREATE INDEX IF NOT EXISTS idx_events_type ON events(event_type);</sql><current_tab id="4"/></tab_sql></sqlb_project>
